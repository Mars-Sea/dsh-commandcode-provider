node_modules/
# Local scratch from aligning the checkout's peers with the engine release
# (a workspace-local npm cache, since ~/.npm is outside the sandbox).
node_modules.bak/
.npm-cache/
# DSH STORE reviews the fixed Git Commit, so the built runtime files ship in
# git. `lib/` artifacts are committed explicitly with `git add -f`; the ignore
# stays so map churn and stray local rebuilds do not show up as noise.
lib/
*.tgz
.DS_Store
# Keep the reusable DSH release audit skill in the repository; other local
# agent scratch and the existing upstream-data skill remain ignored.
.agents/*
!.agents/
!.agents/skills/
.agents/skills/*
!.agents/skills/dsh-release-upgrade/
!.agents/skills/dsh-release-upgrade/**

# The official Command Code CLI's per-project state (e.g. `taste/`), created by
# running the CLI inside this checkout. Local-only: never commit, never publish.
.commandcode/

# Maintainer-local release guide: never commit, never publish.
RELEASES.local.md
__pycache__/
